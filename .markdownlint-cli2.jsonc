{
  // Проверяем только наши документы. sources/ (документы заказчика) не входит в список — мы их не правим.
  "globs": ["tz/**/*.md", "decisions/**/*.md", "notes/**/*.md", "README.md"],
  "config": {
    // Выключено: принято правило «одно предложение — одна строка», строки получаются длинными.
    "MD013": false,
    // Выключено: файлы разделов — части одного документа и начинаются с ##, а не с заголовка первого уровня.
    "MD041": false,
    // Выключено: стиль разделителя таблиц не влияет на сборку DOCX.
    "MD060": false
  }
}
